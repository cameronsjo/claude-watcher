# LLM gateway — any OpenAI-compatible endpoint.
# In the estate this is agentgateway, reachable in-cluster.
WATCHER_LLM_BASE_URL=http://agentgateway:8082/v1
WATCHER_LLM_API_KEY=
# Map and reduce share one preset on purpose: llama-server autoloads presets on
# demand and each load evicts the others.
# WATCHER_LLM_MAP_MODEL=local/Qwen3.8-27B-Heretic-RVN-Q4_K_M
# WATCHER_LLM_REDUCE_MODEL=local/Qwen3.8-27B-Heretic-RVN-Q4_K_M
# Input budgets, sized against the local preset's 262144-token window.
# WATCHER_SUMMARIZER_MAX_INPUT_CHARS=120000
# WATCHER_SUMMARIZER_MAX_REDUCE_CHARS=200000

# Discord webhook
WATCHER_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Email (SMTP) — Postmark recommended
WATCHER_SMTP_HOST=smtp.postmarkapp.com
WATCHER_SMTP_PORT=587
WATCHER_SMTP_USERNAME=your-server-api-token
WATCHER_SMTP_PASSWORD=your-server-api-token
WATCHER_EMAIL_FROM=watcher@yourdomain.com
# Comma-separated recipients
WATCHER_EMAIL_TO=you@personal.com,you@work.com

# Git remote (optional) — push snapshot history to a remote repo after each commit.
# Embed credentials in the URL for token auth. Leave unset to keep commits local
# to the snapshots volume only.
# WATCHER_GIT_REMOTE_URL=http://user:token@gitea:3000/cameron/claude-docs-snapshots.git

# Anthropic API docs source (optional; defaults shown). Empty disables.
# Run `make seed` once after enabling, before starting the scheduler.
# WATCHER_API_DOCS_BASE_URL=https://platform.claude.com

# Schedule (optional, defaults shown)
# WATCHER_CHANGELOG_PEAK_INTERVAL_HOURS=1
# WATCHER_CHANGELOG_OFFPEAK_INTERVAL_HOURS=4
# WATCHER_DOCS_CHECK_HOUR_UTC=6

# Logging
# WATCHER_LOG_LEVEL=INFO

# Drift check — detects when upstream docs contradict ecosystem files
# Requires WATCHER_LLM_API_KEY to be set
# WATCHER_DRIFT_CHECK_ENABLED=false
# WATCHER_DRIFT_MAPPINGS_FILE=drift-mappings.yaml
# Optional: override the model used for drift synthesis
# (defaults to WATCHER_LLM_REDUCE_MODEL)
# WATCHER_DRIFT_REVIEW_MODEL=
